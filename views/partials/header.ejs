
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Header</title>

<!-- Bootstrap CSS -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- Your CSS -->

<link rel="stylesheet"
      href="/styles/header.css">

</head>

<body>

<!-- ================= NAVBAR ================= -->

<nav class="navbar fixed-top custom-navbar">

  <div class="container-fluid">

    <!-- LEFT SIDE -->

    <% if(user){ %>

      <a class="navbar-brand welcome-text">

        WELCOME <%= user.name %>

      </a>

    <% } else { %>

      <a class="navbar-brand"
         href="/signin">

         SIGN IN

      </a>

    <% } %>

    <!-- RIGHT SIDE -->

    <div class="d-flex align-items-center gap-3">

      <% if(user){ %>

        <a class="navbar-brand"
           href="/blog">

           WRITE BLOG

        </a>

      <% } %>

      <!-- HAMBURGER BUTTON -->

      <button class="navbar-toggler"
              type="button"

              data-bs-toggle="offcanvas"

              data-bs-target="#offcanvasNavbar"

              aria-controls="offcanvasNavbar">

        <span class="navbar-toggler-icon"></span>

      </button>

    </div>

    <!-- ================= SIDEBAR ================= -->

    <div class="offcanvas offcanvas-end"
         tabindex="-1"
         id="offcanvasNavbar">

      <!-- SIDEBAR HEADER -->

      <div class="offcanvas-header">

        <h5 class="offcanvas-title">

          BLOG CATEGORIES

        </h5>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="offcanvas">

        </button>

      </div>

      <!-- SIDEBAR BODY -->

      <div class="offcanvas-body">

        <ul class="navbar-nav flex-grow-1">

          <!-- ================= HISTORY ================= -->

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               data-bs-toggle="dropdown">

               INDIAN HISTORY

            </a>

            <ul class="dropdown-menu">

              <li>

                <a class="dropdown-item"
                   href="/blogs/ANCIENT INDIAN HISTORY">

                   ANCIENT INDIAN HISTORY

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/MEDIEVAL INDIAN HISTORY">

                   MEDIEVAL INDIAN HISTORY

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/MODERN INDIAN HISTORY">

                   MODERN INDIAN HISTORY

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/NATIONAL SCIENCE DAY">

                   NATIONAL SCIENCE DAY

                </a>

              </li>

            </ul>

          </li>

          <!-- ================= POLITICS ================= -->

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               data-bs-toggle="dropdown">

               INDIAN POLITICS

            </a>

            <ul class="dropdown-menu">

              <li>

                <a class="dropdown-item"
                   href="/blogs/BASICS">

                   BASICS

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/CENTRAL GOVERNMENT">

                   CENTRAL GOVERNMENT

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/STATE GOVERNMENT">

                   STATE GOVERNMENT

                </a>

              </li>

            </ul>

          </li>

          <!-- ================= SPORTS ================= -->

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               data-bs-toggle="dropdown">

               SPORTS

            </a>

            <ul class="dropdown-menu">

              <li>

                <a class="dropdown-item"
                   href="/blogs/MAJOR SPORTS IN INDIA">

                   MAJOR SPORTS IN INDIA

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/INDIA IN INTERNATIONAL SPORTS">

                   INDIA IN INTERNATIONAL SPORTS

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/SPORTS AWARDS IN INDIA">

                   SPORTS AWARDS IN INDIA

                </a>

              </li>

            </ul>

          </li>

          <!-- ================= SCIENCE ================= -->

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               data-bs-toggle="dropdown">

               SCIENCE

            </a>

            <ul class="dropdown-menu">

              <li>

                <a class="dropdown-item"
                   href="/blogs/ISRO">

                   ISRO

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/ATOMIC ENERGY IN INDIA">

                   ATOMIC ENERGY IN INDIA

                </a>

              </li>

              <li>

                <a class="dropdown-item"
                   href="/blogs/BIOTECHNOLOGY IN INDIA">

                   BIOTECHNOLOGY IN INDIA

                </a>

              </li>

            </ul>

          </li>

        </ul>

        <!-- ================= LOGOUT BUTTON ================= -->

        <% if(user){ %>

        <div class="logout-btn">

          <a href="/logout"
             class="btn btn-danger">

             LOGOUT

          </a>

        </div>

        <% } %>

      </div>

    </div>

  </div>

</nav>

<!-- Bootstrap JS -->

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>

